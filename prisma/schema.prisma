generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//
// ENUMS
//

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  SUPER_ADMIN
}

enum TransactionType {
  INCOME
  EXPENSE
  INVESTMENT
  HAND_LOAN
  TRANSFER
}

enum TransactionKind {
  SALARY
  INTEREST
  AGRI_INCOME
  LEASE_INCOME
  OTHER_INCOME
  HOUSEHOLD
  GROCERY
  FARM_DEV
  WAGE
  FEED
  VACCINATION
  INVESTMENT
  LOAN_PAYMENT
  OTHER_EXPENSE
  REFUND
  SUBSCRIPTION
  UTILITY_BILL
  UTILITY_ADVANCE
  MILK_SALE
  EGG_SALE
  CONTRACT_PAYOUT
  HEALTH_CARE
}

enum MemberChargeType {
  NONE
  RECOVERABLE
  GIFT
}

enum MemberChargeStatus {
  OUTSTANDING
  PARTIAL
  SETTLED
  WRITTEN_OFF
}

// Which way money flows between the workspace owner and the contact:
//   OWED_TO_USER — contact owes the workspace owner (default; existing
//                  flow: I paid for them, they pay me back).
//   USER_OWES    — workspace owner owes the contact (new flow: contact
//                  sent me money via Transfer with createsObligation,
//                  I pay them back).
enum MemberChargeDirection {
  OWED_TO_USER
  USER_OWES
}

enum AccountKind {
  BANK
  CASH
  CARD
  WALLET
}

enum CardKind {
  DEBIT
  CREDIT
}

enum CardLimitMode {
  SOLO
  SHARED
}

enum CardNetwork {
  VISA
  MASTERCARD
  RUPAY
  AMEX
  DINERS
  OTHER
}

enum LoanSource {
  BANK
  HAND_FORMAL
  CARD_EMI
}

enum LoanKind {
  PERSONAL
  HOME
  CAR
  GOLD
  BUSINESS
  EDUCATION
  CREDIT_CARD_LOAN
  OTHER
}

enum LoanFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

enum InvestmentKind {
  STOCK
  FD
  RD
  MUTUAL_FUND
  SIP
  INSURANCE
  GOLD
  OTHER
}

enum InvestmentAction {
  BUY
  SELL
}

enum InsurancePolicyType {
  LIFE
  HEALTH
  VEHICLE
  HOME
  TRAVEL
  TERM
  ULIP
  ENDOWMENT
  OTHER
}

enum InsuranceStatus {
  ACTIVE
  LAPSED
  MATURED
  SURRENDERED
  CLAIMED
  RENEWED
}

enum ClaimStatus {
  FILED
  INTIMATED
  UNDER_REVIEW
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  PAID
  CLOSED
}

enum VehicleKind {
  BIKE
  CAR
  TRACTOR
  TRUCK
  SCOOTER
  OTHER
}

// Drives the unit shown on fuel-fill inputs (litres / units / kg) and
// the per-fill mileage calc. Optional on Vehicle so legacy rows don't
// break — fuel inputs hide when the type is unknown.
enum VehicleFuelType {
  PETROL
  DIESEL
  CNG
  LPG
  ELECTRIC
  HYBRID
  OTHER
}

enum VehicleDisposalKind {
  SOLD
  EXCHANGED
  SCRAPPED
  GIFTED
  TOTAL_LOSS
}

enum VehicleDocumentKind {
  RC
  FC
  PUC
  ROAD_TAX
  INSURANCE_COPY
  OTHER
}

enum InsuredMemberRole {
  INSURED
  BENEFICIARY
}

enum HospitalizationStage {
  PRE
  DURING
  POST
}

enum MedicalRecordKind {
  CHECKUP
  HOSPITALIZATION
}

enum GoldForm {
  ORNAMENT
  COIN
  BAR
  BISCUIT
  JEWELLERY_MAKING
}

enum NotificationKind {
  PREMIUM_DUE_SOON
  PREMIUM_OVERDUE
  POLICY_RENEWING
  CLAIM_STATUS_CHANGED
  CARD_STATEMENT_DUE
  LOAN_EMI_DUE
  SUBSCRIPTION_RENEWAL_DUE
  UTILITY_BILL_DUE_SOON
  UTILITY_BILL_OVERDUE
  // Variable-cadence connection whose bill is expected around now —
  // prompt to check the meter/portal and enter it. No amount attached.
  UTILITY_BILL_EXPECTED
  // Prepaid connection (JioAirFiber, mobile prepaid, …) whose recharge
  // validity is running out — prompt to recharge before it expires.
  UTILITY_RECHARGE_DUE_SOON
  VACCINATION_DUE
  LIVESTOCK_CYCLE_ENDING
  PAYMENT_FAILED
  GENERIC
}

enum PremiumFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
  EVERY_2_YEARS
  EVERY_3_YEARS
  EVERY_5_YEARS
  ONE_TIME
}

enum CompoundingFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

enum FDStatus {
  ACTIVE
  MATURED
  CLOSED
  PREMATURE_WITHDRAWAL
}

enum CropStatus {
  PLANNED
  ACTIVE
  HARVESTED
  CLOSED
}

enum LivestockEventType {
  PURCHASE
  BIRTH
  DEATH
  SALE
}

enum LeaseAssetType {
  CROP_BATCH
  LIVESTOCK_BATCH
}

// Drives which fields the batch form asks for, which tabs the detail
// page shows, and which formulas the analytics endpoint runs. Stored
// per-batch so a single Livestock row (e.g. "Goats") can host a mix of
// dairy + meat batches over time.
enum ProductionType {
  BROILER_CONTRACT
  BROILER_INDEPENDENT
  LAYER
  COUNTRY_CHICKEN
  DAIRY
  MEAT_GOAT
  MEAT_SHEEP
  DUAL_PURPOSE
}

enum AnimalSex {
  MALE
  FEMALE
  UNKNOWN
}

enum MortalityCause {
  UNKNOWN
  DISEASE
  PREDATOR
  INJURY
  HEAT
  COLD
  STAMPEDE
  OTHER
}

enum WeighingPhase {
  ARRIVAL
  INTERIM
  WEEKLY
  EXIT
}

enum LeaseDirection {
  LEASED_OUT
  LEASED_IN
}

enum LeaseFrequency {
  ONE_TIME
  YEARLY
  CUSTOM_MONTHS
}

enum WageSettlementCadence {
  AS_NEEDED
  WEEKLY
  MONTHLY
  CUSTOM
}

enum WageSettlementStatus {
  PENDING
  SETTLED
  CANCELLED
}

enum AreaUnit {
  ACRES
  HECTARES
  CENTS
  SQFT
  SQM
}

enum ReminderKind {
  SIP_BUY
  FD_INTEREST
  INSURANCE_PREMIUM
  LEASE_PAYMENT
  LOAN_EMI
  CARD_STATEMENT
  VEHICLE_DOC_RENEWAL
  SUBSCRIPTION_RENEWAL
  UTILITY_BILL_DUE
  // A variable-cadence provider (`cycleVaries`) is around due to issue a
  // bill. Not payable — it prompts the user to check and enter the real
  // bill. dueDate = the expected statement date.
  UTILITY_BILL_EXPECTED
  // Prepaid recharge validity expiring (dueDate = the validity date).
  UTILITY_RECHARGE_DUE
  VACCINATION_DUE
  LIVESTOCK_CYCLE_ENDING
}

enum ReminderStatus {
  UPCOMING
  CONFIRMED
  SKIPPED
  MISSED
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum SubscriptionCycle {
  WEEKLY
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

enum UtilityKind {
  ELECTRICITY
  INTERNET
  MOBILE_POSTPAID
  MOBILE_PREPAID
  DTH
  GAS
  WATER
  OTHER
}

enum UtilityProviderStatus {
  ACTIVE
  INACTIVE
}

// How often a recurring provider generates a bill. Utilities in India
// are commonly monthly (mobile/DTH/internet) or bimonthly (TN
// electricity is billed every two months).
enum UtilityBillCycle {
  MONTHLY
  BIMONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

// Whether a recurring provider's bill amount is known in advance.
// FIXED    → auto-generate at `defaultAmount` and let autopay pay it.
// VARIABLE → auto-generate an `estimated` placeholder that waits for the
//            user to enter the real amount before it's eligible for pay.
enum UtilityAmountMode {
  FIXED
  VARIABLE
}

//
// IDENTITY
//

model User {
  id                String     @id @default(uuid())
  name              String
  email             String     @unique
  emailVerified     DateTime?
  passwordHash      String
  activeWorkspaceId String?
  activeWorkspace   Workspace? @relation("UserActiveWorkspace", fields: [activeWorkspaceId], references: [id], onDelete: SetNull)
  lastLoginAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  ownedWorkspaces         Workspace[]              @relation("WorkspaceOwner")
  memberships             WorkspaceMember[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  contactProfile          Contact?

  ownedAccounts             Account[]          @relation("AccountOwner")
  ownedCards                Card[]             @relation("CardOwner")
  ownedLoans                Loan[]             @relation("LoanOwner")
  ownedInvestments          Investment[]       @relation("InvestmentOwner")
  ownedStockWishlist        StockWishlist[]    @relation("StockWishlistOwner")
  ownedSubscriptions        Subscription[]     @relation("SubscriptionOwner")
  ownedUtilityProviders     UtilityProvider[]  @relation("UtilityProviderOwner")
  transactions              Transaction[]      @relation("TransactionAuthor")
  createdTransactions       Transaction[]      @relation("TransactionCreatedBy")
  editedTransactions        Transaction[]      @relation("TransactionEditedBy")
  wagePayments              WagePayment[]
  wageSettlements           WageSettlement[]
  receivedAdvanceRepayments AdvanceRepayment[] @relation("AdvanceRepaymentReceiver")
  reversedAdvanceRepayments AdvanceRepayment[] @relation("AdvanceRepaymentReverser")
  transfers                 Transfer[]         @relation("TransferAuthor")
  auditLogs                 AuditLog[]
  sentWorkspaceInvites      WorkspaceInvite[]  @relation("WorkspaceInviteInviter")
  notifications             Notification[]
  uploadedAttachments       Attachment[]       @relation("AttachmentUploader")
  archivedAttachments       Attachment[]       @relation("AttachmentArchiver")
  editedCardStatements      CardStatement[]    @relation("CardStatementEditor")

  @@index([email])
}

model Workspace {
  id                        String   @id @default(uuid())
  name                      String
  slug                      String?  @unique
  ownerUserId               String
  owner                     User     @relation("WorkspaceOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  // How many days a non-card transaction stays editable from its date.
  // Card-account transactions follow a different rule (locked once their
  // billing period closes into a CardStatement). 0 disables the window.
  transactionEditWindowDays Int      @default(30)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  members             WorkspaceMember[]
  invites             WorkspaceInvite[]
  activeForUsers      User[]               @relation("UserActiveWorkspace")
  contacts            Contact[]
  categories          Category[]
  accounts            Account[]
  cards               Card[]
  cardStatements      CardStatement[]
  transactions        Transaction[]
  transactionSplits   TransactionSplit[]
  transfers           Transfer[]
  memberCharges       MemberCharge[]
  lands               Land[]
  crops               Crop[]
  livestock           Livestock[]
  livestockContracts  LivestockContract[]
  leases              Lease[]
  workers             Worker[]
  advanceRepayments   AdvanceRepayment[]
  loans               Loan[]
  investments         Investment[]
  investmentReminders InvestmentReminder[]
  insuredMembers      InsuredMember[]
  insuranceClaims     InsuranceClaim[]
  vehicles            Vehicle[]
  vehicleDocuments    VehicleDocument[]
  medicalRecords      MedicalRecord[]
  events              Event[]
  notifications       Notification[]
  attachments         Attachment[]
  stockWishlist       StockWishlist[]
  auditLogs           AuditLog[]
  subscriptions       Subscription[]
  utilityProviders    UtilityProvider[]
  utilityBills        UtilityBill[]

  @@index([ownerUserId])
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        WorkspaceRole
  permissions Json          @default("{}")
  /**
   * Per-member email-notification preferences. Shape:
   * { enabled: boolean, kinds: NotificationKind[] }
   * Default = opted in for all kinds; users opt out from /settings.
   * The server-side `shouldEmail()` also treats unset/missing `enabled`
   * as opted-in, so this default + that fallback both point the same way.
   */
  emailPrefs  Json          @default("{\"enabled\":true}")
  invitedAt   DateTime      @default(now())
  acceptedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, role])
}

model WorkspaceInvite {
  id              String        @id @default(uuid())
  workspaceId     String
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email           String
  role            WorkspaceRole
  permissions     Json          @default("{}")
  tokenHash       String        @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  cancelledAt     DateTime?
  invitedByUserId String
  invitedByUser   User          @relation("WorkspaceInviteInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([workspaceId, acceptedAt])
  @@index([email, acceptedAt])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Contact {
  id           String    @id @default(uuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  relationship String?
  dob          DateTime? @db.Date
  userId       String?   @unique
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  notes        String?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  ownedAccounts      Account[]          @relation("AccountContactOwner")
  ownedCards         Card[]             @relation("CardContactOwner")
  beneficiaryTxns    Transaction[]      @relation("TransactionBeneficiary")
  paidByTxns         Transaction[]      @relation("TransactionPaidBy")
  transactionSplits  TransactionSplit[] @relation("ContactSplits")
  sentTransfers      Transfer[]         @relation("TransferFromContact")
  receivedTransfers  Transfer[]         @relation("TransferToContact")
  memberCharges      MemberCharge[]
  lessorLeases       Lease[]            @relation("LeaseLessor")
  lesseeLeases       Lease[]            @relation("LeaseLessee")
  lenderLoans        Loan[]             @relation("LoanLenderContact")
  memberLoans        Loan[]             @relation("LoanMemberContact")
  insuredMemberships InsuredMember[]    @relation("InsuredMemberContact")
  ownedVehicles      Vehicle[]          @relation("VehicleOwner")
  vehiclesBought     Vehicle[]          @relation("VehicleDisposalBuyer")
  medicalRecords     MedicalRecord[]    @relation("MedicalRecordPatient")
  livestockContracts LivestockContract[] @relation("LivestockContractContact")

  @@index([workspaceId, active])
}

//
// MONEY
//

model Account {
  id                String      @id @default(uuid())
  workspaceId       String
  workspace         Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ownerUserId       String?
  ownerUser         User?       @relation("AccountOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  ownerContactId    String?
  ownerContact      Contact?    @relation("AccountContactOwner", fields: [ownerContactId], references: [id], onDelete: SetNull)
  sharedWithUserIds String[]    @default([])
  kind              AccountKind
  name              String
  openingBalance    Decimal     @default(0) @db.Decimal(14, 2)
  creditLimit       Decimal?    @db.Decimal(14, 2)
  statementDate     Int?
  gracePeriod       Int?
  // For CREDIT companion accounts: pre-existing bill due date + amount
  // captured at onboarding. Used when the user adds a card that already
  // has a generated statement due before the regular cycle math takes
  // over. Cleared/updated by the user manually after the bill is paid.
  nextBillDue       DateTime?
  nextBillAmount    Decimal?    @db.Decimal(14, 2)
  active            Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  transactions     Transaction[]
  loans            Loan[]
  transfersFrom    Transfer[]        @relation("TransferFrom")
  transfersTo      Transfer[]        @relation("TransferTo")
  cardsAsParent    Card[]            @relation("CardParentAccount")
  linkedCard       Card?             @relation("CardAccount")
  cardStatements   CardStatement[]
  subscriptions    Subscription[]    @relation("SubscriptionAccount")
  utilityProviders UtilityProvider[] @relation("UtilityProviderAccount")

  @@index([workspaceId, active])
  @@index([workspaceId, ownerUserId])
  @@index([workspaceId, ownerContactId])
}

model Card {
  id                String        @id @default(uuid())
  workspaceId       String
  workspace         Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ownerUserId       String?
  ownerUser         User?         @relation("CardOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  ownerContactId    String?
  ownerContact      Contact?      @relation("CardContactOwner", fields: [ownerContactId], references: [id], onDelete: SetNull)
  sharedWithUserIds String[]      @default([])
  name              String
  kind              CardKind
  network           CardNetwork   @default(OTHER)
  supportsUpi       Boolean       @default(false)
  last4             String?
  parentAccountId   String?
  parentAccount     Account?      @relation("CardParentAccount", fields: [parentAccountId], references: [id], onDelete: SetNull)
  accountId         String?       @unique
  account           Account?      @relation("CardAccount", fields: [accountId], references: [id], onDelete: SetNull)
  limitMode         CardLimitMode @default(SOLO)
  parentCardId      String?
  parentCard        Card?         @relation("CardParentCard", fields: [parentCardId], references: [id], onDelete: SetNull)
  childCards        Card[]        @relation("CardParentCard")
  active            Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  transactions     Transaction[]
  emiLoans         Loan[]            @relation("CardEmiLoan")
  subscriptions    Subscription[]    @relation("SubscriptionCard")
  utilityProviders UtilityProvider[] @relation("UtilityProviderCard")

  @@index([workspaceId, active])
  @@index([workspaceId, ownerUserId])
  @@index([parentAccountId])
  @@index([parentCardId])
}

model CardStatement {
  id                 String               @id @default(uuid())
  workspaceId        String
  workspace          Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accountId          String
  account            Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  periodStart        DateTime             @db.Date
  periodEnd          DateTime             @db.Date
  dueDate            DateTime             @db.Date
  totalDue           Decimal              @db.Decimal(14, 2)
  paidAt             DateTime?
  // Many transfers can pay down one statement (partial payments). The
  // earlier `paidTransfer` 1-to-1 relation modelled "the single transfer
  // that closed this bill" but real-world bills are often paid in
  // instalments, so it's been replaced with this 1-to-many.
  payments           Transfer[]           @relation("StatementPayments")
  closedAt           DateTime?
  reminders          InvestmentReminder[] @relation("ReminderCardStatement")
  // When set, the row was hand-edited (`totalDue` / `dueDate` corrected by
  // a user). The materializer must NOT re-snapshot these fields on its
  // next run — see `card-statement-service.ts`.
  manuallyEdited     Boolean              @default(false)
  manuallyEditedAt   DateTime?
  manuallyEditedById String?
  manuallyEditedBy   User?                @relation("CardStatementEditor", fields: [manuallyEditedById], references: [id], onDelete: SetNull)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@unique([accountId, periodStart])
  @@index([accountId, periodEnd])
  @@index([workspaceId])
}

model Transfer {
  id                String         @id @default(uuid())
  workspaceId       String
  workspace         Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId            String
  user              User           @relation("TransferAuthor", fields: [userId], references: [id], onDelete: Cascade)
  // Exactly one of fromAccountId / fromContactId is set, and exactly one of
  // toAccountId / toContactId is set. At least one side must be an account
  // (contact-to-contact transfers don't touch this workspace's books).
  fromAccountId     String?
  fromAccount       Account?       @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  fromContactId     String?
  fromContact       Contact?       @relation("TransferFromContact", fields: [fromContactId], references: [id], onDelete: Restrict)
  toAccountId       String?
  toAccount         Account?       @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Restrict)
  toContactId       String?
  toContact         Contact?       @relation("TransferToContact", fields: [toContactId], references: [id], onDelete: Restrict)
  amount            Decimal        @db.Decimal(14, 2)
  date              DateTime
  notes             String?
  statementId       String?
  statement         CardStatement? @relation("StatementPayments", fields: [statementId], references: [id], onDelete: SetNull)
  legs              Transaction[]  @relation("TransferLegs")
  // When true on a fromContact→toAccount transfer, the inbound money is
  // a loan/advance from the contact — we create a MemberCharge with
  // direction=USER_OWES so the user can settle it later.
  createsObligation Boolean        @default(false)
  obligationCharges MemberCharge[] @relation("TransferObligation")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([workspaceId, date])
  @@index([fromAccountId])
  @@index([fromContactId])
  @@index([toAccountId])
  @@index([toContactId])
  @@index([statementId])
}

//
// LEDGER
//

model Category {
  id               String            @id @default(uuid())
  name             String
  types            TransactionType[]
  group            String?
  icon             String?
  isDefault        Boolean           @default(false)
  workspaceId      String?
  workspace        Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Two-level hierarchy: parents have parentCategoryId = null,
  // children point at their parent. Three-level nesting is rejected
  // at the API layer, not the DB.
  parentCategoryId String?
  parent           Category?         @relation("CategoryChildren", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  children         Category[]        @relation("CategoryChildren")
  transactions     Transaction[]
  subscriptions    Subscription[]    @relation("SubscriptionCategory")
  createdAt        DateTime          @default(now())

  @@index([name])
  @@index([workspaceId])
  @@index([workspaceId, parentCategoryId])
}

model Transaction {
  id          String           @id @default(uuid())
  workspaceId String
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  amount      Decimal          @db.Decimal(12, 2)
  type        TransactionType
  kind        TransactionKind?
  description String
  date        DateTime
  categoryId  String?
  category    Category?        @relation(fields: [categoryId], references: [id])

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  cardId    String?
  card      Card?    @relation(fields: [cardId], references: [id], onDelete: SetNull)

  workerId String?
  worker   Worker? @relation(fields: [workerId], references: [id], onDelete: SetNull)

  cropBatchId      String?
  cropBatch        CropBatch?      @relation(fields: [cropBatchId], references: [id], onDelete: SetNull)
  livestockBatchId String?
  livestockBatch   LivestockBatch? @relation(fields: [livestockBatchId], references: [id], onDelete: SetNull)

  leaseId         String?
  lease           Lease?                @relation(fields: [leaseId], references: [id], onDelete: SetNull)
  leaseScheduleId String?               @unique
  leaseSchedule   LeasePaymentSchedule? @relation("ScheduleConfirmedTxn", fields: [leaseScheduleId], references: [id], onDelete: SetNull)

  loanId String?
  loan   Loan?   @relation(fields: [loanId], references: [id], onDelete: SetNull)

  investmentId     String?
  investment       Investment?       @relation(fields: [investmentId], references: [id], onDelete: SetNull)
  investmentAction InvestmentAction?
  investmentQty    Decimal?          @db.Decimal(14, 4)
  investmentPrice  Decimal?          @db.Decimal(14, 4)
  exchangeRate     Decimal?          @db.Decimal(10, 4)

  transferId String?
  transfer   Transfer? @relation("TransferLegs", fields: [transferId], references: [id], onDelete: Cascade)

  // Refund linkage: an income-side transaction with kind=REFUND can point
  // to the original expense it reverses. SET NULL on delete so the refund
  // record survives if the original purchase is deleted.
  refundForTransactionId String?
  refundForTransaction   Transaction?  @relation("RefundOfTransaction", fields: [refundForTransactionId], references: [id], onDelete: SetNull)
  refundsReceived        Transaction[] @relation("RefundOfTransaction")

  userId          String
  user            User      @relation("TransactionAuthor", fields: [userId], references: [id], onDelete: Cascade)
  createdByUserId String?
  createdByUser   User?     @relation("TransactionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  editedByUserId  String?
  editedByUser    User?     @relation("TransactionEditedBy", fields: [editedByUserId], references: [id], onDelete: SetNull)
  editedAt        DateTime?
  editNote        String?

  beneficiaryContactId String?
  beneficiaryContact   Contact?         @relation("TransactionBeneficiary", fields: [beneficiaryContactId], references: [id], onDelete: SetNull)
  memberChargeType     MemberChargeType @default(NONE)

  // When a contact paid this expense for the workspace owner. The
  // expense is still recorded in the owner's books (categorized,
  // counted in cashflow) but no account/card balance is touched.
  // Combined with `memberChargeType = RECOVERABLE`, a MemberCharge
  // with direction = USER_OWES is created so the owner can settle it
  // later. GIFT means the contact won't be paid back.
  paidByContactId String?
  paidByContact   Contact? @relation("TransactionPaidBy", fields: [paidByContactId], references: [id], onDelete: SetNull)

  claimId String?
  claim   InsuranceClaim? @relation("TransactionClaim", fields: [claimId], references: [id], onDelete: SetNull)

  vehicleId String?
  vehicle   Vehicle? @relation("VehicleTransaction", fields: [vehicleId], references: [id], onDelete: SetNull)

  // Fuel-fill metadata — only meaningful on EXPENSE transactions
  // tagged to a vehicle with category = Fuel. fuelQuantity is litres
  // or kWh or kg depending on the vehicle's fuelType at the time;
  // fuelUnit stores the symbol so historical reads stay correct even
  // if the vehicle is converted to a different fuel type later.
  // fuelOdometer is the km reading at the fill, used for mileage.
  fuelQuantity Decimal? @db.Decimal(10, 3)
  fuelUnit     String?
  fuelOdometer Int?

  // Medical tagging. Bills roll up under a patient's medical record;
  // hospitalizationStage only applies when the record kind is HOSPITALIZATION.
  medicalRecordId      String?
  medicalRecord        MedicalRecord?        @relation("TransactionMedicalRecord", fields: [medicalRecordId], references: [id], onDelete: SetNull)
  hospitalizationStage HospitalizationStage?

  // Event/Trip tagging. Multiple transactions roll up under one event
  // (e.g. "Tirupati trip"). SET NULL on event delete so transactions
  // are never destroyed when an event is removed.
  eventId String?
  event   Event?  @relation("EventTransaction", fields: [eventId], references: [id], onDelete: SetNull)

  // Subscription pay (kind=SUBSCRIPTION). subscriptionId is the master
  // config; subscriptionScheduleId is the specific cycle this txn paid.
  subscriptionId         String?
  subscription           Subscription?         @relation("SubscriptionTransaction", fields: [subscriptionId], references: [id], onDelete: SetNull)
  subscriptionScheduleId String?               @unique
  subscriptionSchedule   SubscriptionSchedule? @relation("SubscriptionScheduleConfirmedTxn", fields: [subscriptionScheduleId], references: [id], onDelete: SetNull)

  // Utility bill pay (kind=UTILITY_BILL) or advance deposit (kind=UTILITY_ADVANCE).
  utilityProviderId String?
  utilityProvider   UtilityProvider? @relation("UtilityProviderTransaction", fields: [utilityProviderId], references: [id], onDelete: SetNull)
  utilityBillId     String?          @unique
  utilityBill       UtilityBill?     @relation("UtilityBillPaidTxn", fields: [utilityBillId], references: [id], onDelete: SetNull)

  goldForm GoldForm?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wagePayment             WagePayment?
  advanceRepayment        AdvanceRepayment?
  livestockEvent          LivestockEvent?
  feedLog                 FeedLog?
  vaccinationLog          VaccinationLog?
  milkLog                 MilkLog?
  eggProductionLog        EggProductionLog?
  healthLog               HealthLog?
  memberChargeSettlements MemberChargeSettlement[]
  reminderConfirmation    InvestmentReminder?      @relation("ReminderConfirmation")
  splits                  TransactionSplit[]       @relation("TransactionSplits")

  @@index([workspaceId, date])
  @@index([workspaceId, categoryId])
  @@index([workspaceId, accountId])
  @@index([cardId])
  @@index([workerId])
  @@index([cropBatchId])
  @@index([livestockBatchId])
  @@index([leaseId])
  @@index([loanId])
  @@index([investmentId])
  @@index([transferId])
  @@index([beneficiaryContactId])
  @@index([paidByContactId])
  @@index([refundForTransactionId])
  @@index([claimId])
  @@index([vehicleId])
  @@index([medicalRecordId])
  @@index([eventId])
  @@index([subscriptionId])
  @@index([utilityProviderId])
}

model MemberCharge {
  id                   String                   @id @default(uuid())
  workspaceId          String
  workspace            Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  beneficiaryContactId String
  beneficiaryContact   Contact                  @relation(fields: [beneficiaryContactId], references: [id], onDelete: Restrict)
  amount               Decimal                  @db.Decimal(14, 2)
  settledAmount        Decimal                  @default(0) @db.Decimal(14, 2)
  status               MemberChargeStatus       @default(OUTSTANDING)
  // OWED_TO_USER = contact pays workspace owner (default for existing
  // split / recoverable rows). USER_OWES = workspace owner pays contact
  // (created when an incoming Transfer is marked "I'll pay this back").
  direction            MemberChargeDirection    @default(OWED_TO_USER)
  // When the charge was created by an inbound Transfer (createsObligation
  // = true), this points back to that transfer so the audit trail is
  // explicit. SetNull so deleting the transfer doesn't drop the charge.
  sourceTransferId     String?
  sourceTransfer       Transfer?                @relation("TransferObligation", fields: [sourceTransferId], references: [id], onDelete: SetNull)
  lastSettlementAt     DateTime?
  notes                String?
  originSplit          TransactionSplit?        @relation("SplitCharge")
  settlements          MemberChargeSettlement[]
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([workspaceId, beneficiaryContactId, status])
  @@index([workspaceId, direction, status])
  @@index([sourceTransferId])
}

// One row per contact a transaction is shared with. Replaces the legacy
// single-beneficiary model on Transaction. Each split optionally links to
// a MemberCharge (when the share is recoverable). Splits sum to <= the
// parent transaction amount; the remainder is the author's own share.
model TransactionSplit {
  id             String        @id @default(uuid())
  workspaceId    String
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactionId  String
  transaction    Transaction   @relation("TransactionSplits", fields: [transactionId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact       @relation("ContactSplits", fields: [contactId], references: [id], onDelete: Restrict)
  amount         Decimal       @db.Decimal(14, 2)
  sharePercent   Decimal?      @db.Decimal(6, 3)
  isRecoverable  Boolean       @default(false)
  memberChargeId String?       @unique
  memberCharge   MemberCharge? @relation("SplitCharge", fields: [memberChargeId], references: [id], onDelete: SetNull)
  notes          String?
  createdAt      DateTime      @default(now())

  @@unique([transactionId, contactId])
  @@index([workspaceId, contactId])
  @@index([transactionId])
}

model MemberChargeSettlement {
  id            String       @id @default(uuid())
  chargeId      String
  charge        MemberCharge @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  amount        Decimal      @db.Decimal(14, 2)
  paidAt        DateTime
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  notes         String?
  createdAt     DateTime     @default(now())

  @@index([chargeId, paidAt])
}

//
// FARM
//

model Land {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  area        Decimal?  @db.Decimal(12, 4)
  areaUnit    AreaUnit?
  location    String?
  notes       String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  cropBatches      CropBatch[]
  livestockBatches LivestockBatch[]

  @@index([workspaceId, active])
}

model Crop {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  category    String?
  description String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  batches CropBatch[]

  @@index([workspaceId, active])
}

model CropBatch {
  id                String     @id @default(uuid())
  cropId            String
  crop              Crop       @relation(fields: [cropId], references: [id], onDelete: Cascade)
  landId            String?
  land              Land?      @relation(fields: [landId], references: [id], onDelete: SetNull)
  name              String
  status            CropStatus @default(ACTIVE)
  startDate         DateTime?
  endDate           DateTime?
  expectedCycleDays Int?
  notes             String?
  active            Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  transactions Transaction[]
  attendance   Attendance[]
  leases       Lease[]       @relation("LeaseCropBatch")

  @@index([cropId, status])
  @@index([landId])
}

model Livestock {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  species     String?
  description String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  batches LivestockBatch[]

  @@index([workspaceId, active])
}

model LivestockBatch {
  id                String           @id @default(uuid())
  livestockId       String
  livestock         Livestock        @relation(fields: [livestockId], references: [id], onDelete: Cascade)
  landId            String?
  land              Land?            @relation(fields: [landId], references: [id], onDelete: SetNull)
  name              String
  // Drives form / detail-page variant. Existing rows backfill to
  // DUAL_PURPOSE in the migration so nothing breaks.
  productionType    ProductionType   @default(DUAL_PURPOSE)
  contractId        String?
  contract          LivestockContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  startDate         DateTime
  endDate           DateTime?
  expectedCycleDays Int?
  initialCount      Int              @default(0)
  currentCount      Int              @default(0)
  // Average weight per bird/animal at arrival; drives FCR + ADG math.
  initialAvgWeight  Decimal?         @db.Decimal(8, 3)
  // Optional grower targets — surfaced on the detail page as a goal
  // marker on the weight-gain chart.
  targetWeight      Decimal?         @db.Decimal(8, 3)
  targetFCR         Decimal?         @db.Decimal(5, 3)
  notes             String?
  active            Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  events       LivestockEvent[]
  feedLogs     FeedLog[]
  vaccinations VaccinationLog[]
  transactions Transaction[]
  attendance   Attendance[]
  leases       Lease[]              @relation("LeaseLivestockBatch")
  animals      LivestockAnimal[]
  weighings    WeighingLog[]
  mortality    MortalityLog[]
  milkLogs     MilkLog[]
  eggLogs      EggProductionLog[]
  healthLogs   HealthLog[]
  reminders    InvestmentReminder[] @relation("ReminderLivestockBatch")

  @@index([livestockId, active])
  @@index([landId])
  @@index([contractId])
  @@index([productionType, active])
}

model LivestockEvent {
  id            String             @id @default(uuid())
  batchId       String
  batch         LivestockBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  eventType     LivestockEventType
  date          DateTime
  count         Int
  unitValue     Decimal?           @db.Decimal(12, 2)
  // Per-animal average weight at the time of the event. Combined with
  // `count` this gives total weight; surfaced on PURCHASE/SALE rows so
  // the detail-page table reads "12 birds · avg 2.10 kg · ₹120/bird".
  avgWeightKg   Decimal?           @db.Decimal(8, 3)
  // Optional total weight override when the user actually weighed the
  // bulk lot (e.g. a goat sale) instead of averaging.
  totalWeightKg Decimal?           @db.Decimal(12, 3)
  notes         String?
  transactionId String?            @unique
  transaction   Transaction?       @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  createdAt     DateTime           @default(now())

  @@index([batchId, date])
}

// Optional per-animal layer on top of a batch. For poultry batches we
// almost never use this (1000 broilers, nobody names them); for a dairy
// herd of 8 named cows we do. Models like WeighingLog / MortalityLog
// can reference either the batch (bulk events) or a specific animal.
model LivestockAnimal {
  id          String           @id @default(uuid())
  batchId     String
  batch       LivestockBatch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  tagNumber   String
  name        String?
  sex         AnimalSex        @default(UNKNOWN)
  dob         DateTime?
  breed       String?
  color       String?
  notes       String?
  // Flips to false on individual SALE / DEATH so the active herd view
  // stays clean while history is preserved.
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  weighings   WeighingLog[]
  mortality   MortalityLog[]
  milkLogs    MilkLog[]
  healthLogs  HealthLog[]

  @@unique([batchId, tagNumber])
  @@index([batchId, active])
}

// Captures the "weight on buy / sell / interim weigh-in" data that
// drives FCR, ADG, and contract-payout math. Bulk events use
// (sampleSize, totalKg, avgKg) — sampling a handful of birds is
// industry-standard for broiler. Per-animal events set animalId and
// usually sampleSize=1.
model WeighingLog {
  id          String           @id @default(uuid())
  batchId     String
  batch       LivestockBatch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  animalId    String?
  animal      LivestockAnimal? @relation(fields: [animalId], references: [id], onDelete: SetNull)
  phase       WeighingPhase
  date        DateTime
  sampleSize  Int              @default(1)
  totalKg     Decimal          @db.Decimal(12, 3)
  // Denormalised = totalKg / sampleSize. Stored to keep the analytics
  // query fast and to survive sampleSize edits without a recompute.
  avgKg       Decimal          @db.Decimal(8, 3)
  notes       String?
  createdAt   DateTime         @default(now())

  @@index([batchId, date])
  @@index([animalId, date])
}

// Daily milk production for DAIRY batches. `sessions` is a denormalised
// Json bag (e.g. `{ MORNING: 12.5, EVENING: 11.0 }`) so a farmer who
// milks three times a day doesn't need a schema change. When `sold` and
// `ratePerLitre` are present the API creates a linked INCOME
// Transaction tagged to the batch so dashboard cashflow stays accurate.
// `animalId` is optional — populated only when the farmer records per-
// cow yield (named dairy cows). Bulk dairy units skip it.
model MilkLog {
  id              String           @id @default(uuid())
  batchId         String
  batch           LivestockBatch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  animalId        String?
  animal          LivestockAnimal? @relation(fields: [animalId], references: [id], onDelete: SetNull)
  date            DateTime
  // Denormalised totals so the chart query is fast. `sessions` keeps the
  // per-session breakdown for the detail view.
  totalLitres     Decimal          @db.Decimal(10, 3)
  sessions        Json?
  fatPct          Decimal?         @db.Decimal(4, 2)
  snfPct          Decimal?         @db.Decimal(4, 2)
  // Sold portion (litres) + price. The remainder is treated as home use.
  soldLitres      Decimal?         @db.Decimal(10, 3)
  ratePerLitre    Decimal?         @db.Decimal(8, 2)
  // Linked INCOME Transaction when sold + rate are both set. Nullable so
  // a production-only log (no sale yet) is still a valid row.
  transactionId   String?          @unique
  transaction     Transaction?     @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  notes           String?
  createdAt       DateTime         @default(now())

  @@index([batchId, date])
  @@index([animalId, date])
}

// Health / disease log — beyond vaccinations. Captures the symptom,
// treatment given, and (optional) cost. When cost > 0 + a source is
// set, the API creates a linked EXPENSE Transaction (kind=HEALTH_CARE).
// `resolved` flips when the animal recovers; `resolvedAt` stamps the
// date. Used by all production types — birds, dairy, goats alike.
model HealthLog {
  id            String           @id @default(uuid())
  batchId       String
  batch         LivestockBatch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  animalId      String?
  animal        LivestockAnimal? @relation(fields: [animalId], references: [id], onDelete: SetNull)
  date          DateTime
  condition     String
  treatment     String?
  cost          Decimal?         @db.Decimal(12, 2)
  resolved      Boolean          @default(false)
  resolvedAt    DateTime?
  transactionId String?          @unique
  transaction   Transaction?     @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  notes         String?
  createdAt     DateTime         @default(now())

  @@index([batchId, date])
  @@index([animalId, date])
  @@index([batchId, resolved])
}

// Daily egg production for LAYER + COUNTRY_CHICKEN batches. `grades`
// is a denormalised Json bag (e.g. `{ SMALL: 12, MEDIUM: 80, LARGE: 30 }`)
// so the grade taxonomy can evolve without a schema bump. When `sold`
// and `salePricePerEgg` are both set the API creates a linked INCOME
// Transaction (kind=EGG_SALE) tagged to the batch. Mirrors MilkLog.
model EggProductionLog {
  id              String           @id @default(uuid())
  batchId         String
  batch           LivestockBatch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  date            DateTime
  collected       Int
  grades          Json?
  broken          Int?
  // Sale columns — when both set, API creates an INCOME Transaction.
  sold            Int?
  salePricePerEgg Decimal?         @db.Decimal(8, 2)
  transactionId   String?          @unique
  transaction     Transaction?     @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  notes           String?
  createdAt       DateTime         @default(now())

  @@index([batchId, date])
}

// First-class mortality log with cause + culled flag. Replaces the
// old "just record a DEATH LivestockEvent and bump the count" pattern,
// which conflated cause-of-death with movement. Deleting a row in the
// API auto-restores LivestockBatch.currentCount.
model MortalityLog {
  id        String           @id @default(uuid())
  batchId   String
  batch     LivestockBatch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  animalId  String?
  animal    LivestockAnimal? @relation(fields: [animalId], references: [id], onDelete: SetNull)
  date      DateTime
  count     Int              @default(1)
  cause     MortalityCause   @default(UNKNOWN)
  // Farmer-initiated cull (sick / runt) vs natural death. Contract
  // integrators sometimes pay for natural mortality but never for culls.
  culled    Boolean          @default(false)
  notes     String?
  createdAt DateTime         @default(now())

  @@index([batchId, date])
  @@index([animalId, date])
}

// The Suguna / Sakthi / Venky's relationship. Reusing Contact for the
// counterparty (recommended in the planning round) so settlements flow
// through the existing MemberCharge ledger; integratorName /
// contractRef stay denormalised for fast list rendering.
model LivestockContract {
  id              String          @id @default(uuid())
  workspaceId     String
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Optional Contact link — present when the integrator was added to
  // the contacts book; nullable so the user can record a contract
  // before creating the Contact row.
  contactId       String?
  contact         Contact?        @relation("LivestockContractContact", fields: [contactId], references: [id], onDelete: SetNull)
  integratorName  String
  contractRef     String?
  // Base growing charge in ₹ per kg of live weight lifted.
  agreedRatePerKg Decimal         @db.Decimal(10, 2)
  // Json array: [{ "maxFcr": 1.6, "bonusPerKg": 1.50 }, ...]
  // Lower FCR ranges typically pay more — bands evaluated in order,
  // first match wins. Empty array == no bonus structure.
  fcrBonusBands   Json?
  // Mortality % above which penalties kick in (e.g. 5.00 means "no
  // penalty up to 5%, then per-band penalties apply").
  mortalityCap    Decimal?        @db.Decimal(5, 2)
  // Json array: [{ "overByPct": 2, "deductPerKg": 1 }, ...]
  mortalityPenalty Json?
  // Free-form list of what the integrator supplies — DOC, FEED,
  // MEDICINE, VACCINES, TECH. Used only for UI surfacing on the
  // contract card; not validated by an enum so new supplies can be
  // added without a migration.
  suppliesProvided String[]       @default([])
  notes           String?
  startedOn       DateTime
  endedOn         DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  batches         LivestockBatch[]

  @@index([workspaceId, startedOn])
  @@index([contactId])
}

model FeedLog {
  id            String         @id @default(uuid())
  batchId       String
  batch         LivestockBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  date          DateTime
  amount        Decimal        @db.Decimal(12, 2)
  quantity      Decimal?       @db.Decimal(12, 4)
  unit          String?
  notes         String?
  transactionId String?        @unique
  transaction   Transaction?   @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())

  @@index([batchId, date])
}

model VaccinationLog {
  id            String         @id @default(uuid())
  batchId       String
  batch         LivestockBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  vaccine       String
  date          DateTime
  nextDueDate   DateTime?
  cost          Decimal?       @db.Decimal(12, 2)
  notes         String?
  transactionId String?        @unique
  transaction   Transaction?   @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  reminders     InvestmentReminder[] @relation("ReminderVaccination")
  createdAt     DateTime       @default(now())

  @@index([batchId, date])
}

//
// LEASES
//

model Lease {
  id                String          @id @default(uuid())
  workspaceId       String
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  direction         LeaseDirection
  lessorContactId   String?
  lessorContact     Contact?        @relation("LeaseLessor", fields: [lessorContactId], references: [id], onDelete: SetNull)
  lessorName        String?
  lesseeContactId   String?
  lesseeContact     Contact?        @relation("LeaseLessee", fields: [lesseeContactId], references: [id], onDelete: SetNull)
  lesseeName        String?
  assetType         LeaseAssetType
  cropBatchId       String?
  cropBatch         CropBatch?      @relation("LeaseCropBatch", fields: [cropBatchId], references: [id], onDelete: SetNull)
  livestockBatchId  String?
  livestockBatch    LivestockBatch? @relation("LeaseLivestockBatch", fields: [livestockBatchId], references: [id], onDelete: SetNull)
  amount            Decimal         @db.Decimal(14, 2)
  frequency         LeaseFrequency
  customMonths      Int?
  startDate         DateTime
  endDate           DateTime
  scheduleGenerated Boolean         @default(false)
  notes             String?
  active            Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  schedule     LeasePaymentSchedule[]
  transactions Transaction[]

  @@index([workspaceId, active])
  @@index([cropBatchId])
  @@index([livestockBatchId])
}

model LeasePaymentSchedule {
  id           String               @id @default(uuid())
  leaseId      String
  lease        Lease                @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  dueDate      DateTime             @db.Date
  amount       Decimal              @db.Decimal(14, 2)
  status       ReminderStatus       @default(UPCOMING)
  confirmedTxn Transaction?         @relation("ScheduleConfirmedTxn")
  reminders    InvestmentReminder[] @relation("ReminderLeaseSchedule")
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([leaseId, dueDate])
  @@index([status, dueDate])
}

//
// SUBSCRIPTIONS — Netflix, Spotify, etc. Header-level config with a
// single rolling "next cycle" schedule row (like Loan.nextDueDate) and
// a per-cycle reminder. Each Pay creates a Transaction (kind=SUBSCRIPTION),
// confirms the schedule + reminder, advances nextBillingDate, and creates
// the next schedule + reminder.
//
model Subscription {
  id                String             @id @default(uuid())
  workspaceId       String
  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ownerUserId       String?
  owner             User?              @relation("SubscriptionOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  sharedWithUserIds String[]           @default([])
  name              String
  amount            Decimal            @db.Decimal(14, 2)
  cycle             SubscriptionCycle
  nextBillingDate   DateTime           @db.Date
  startedOn         DateTime           @db.Date
  endsOn            DateTime?          @db.Date
  // Payment source: exactly one of accountId or cardId (Zod-enforced).
  accountId         String?
  account           Account?           @relation("SubscriptionAccount", fields: [accountId], references: [id], onDelete: SetNull)
  cardId            String?
  card              Card?              @relation("SubscriptionCard", fields: [cardId], references: [id], onDelete: SetNull)
  autoPay           Boolean            @default(false)
  categoryId        String?
  category          Category?          @relation("SubscriptionCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  logoUrl           String?
  notes             String?
  status            SubscriptionStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedules    SubscriptionSchedule[]
  reminders    InvestmentReminder[]   @relation("ReminderSubscription")
  transactions Transaction[]          @relation("SubscriptionTransaction")

  @@index([workspaceId, status, nextBillingDate])
  @@index([workspaceId, ownerUserId])
}

model SubscriptionSchedule {
  id             String               @id @default(uuid())
  subscriptionId String
  subscription   Subscription         @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  dueDate        DateTime             @db.Date
  amount         Decimal              @db.Decimal(14, 2)
  status         ReminderStatus       @default(UPCOMING)
  skippedReason  String?
  confirmedTxn   Transaction?         @relation("SubscriptionScheduleConfirmedTxn")
  reminders      InvestmentReminder[] @relation("ReminderSubscriptionSchedule")
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([subscriptionId, dueDate])
  @@index([status, dueDate])
}

//
// UTILITIES — providers (TNEB, ACT, Jio, etc.) and their bills. A
// provider can hold an `advanceBalance`; each bill pulls from it first,
// and the cash shortfall (if any) goes from a chosen account/card. For
// ELECTRICITY we track meter readings and units consumed.
//
model UtilityProvider {
  id                String                @id @default(uuid())
  workspaceId       String
  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ownerUserId       String?
  owner             User?                 @relation("UtilityProviderOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  sharedWithUserIds String[]              @default([])
  kind              UtilityKind
  providerName      String
  connectionNumber  String?
  addressLine       String?
  // Default payment source: exactly one of accountId or cardId
  // (Zod-enforced). Bills inherit this unless overridden at pay time.
  accountId         String?
  account           Account?              @relation("UtilityProviderAccount", fields: [accountId], references: [id], onDelete: SetNull)
  cardId            String?
  card              Card?                 @relation("UtilityProviderCard", fields: [cardId], references: [id], onDelete: SetNull)
  autoPay           Boolean               @default(false)
  // Due-date basis. Exactly one applies (Zod/UI enforced):
  //   defaultDueDay   → a FIXED day-of-month (e.g. always the 20th).
  //   gracePeriodDays → N days AFTER the statement date (e.g. due 15 days
  //                     from the bill date). Takes precedence when set.
  // Neither set → a 15-day grace fallback.
  defaultDueDay     Int?
  gracePeriodDays   Int?
  // Auto-pay lead time: pay this many days BEFORE the bill's due date
  // (0 = on the due date itself). Lets payment clear ahead of a deadline.
  autoPayLeadDays   Int                   @default(0)
  // ── Recurrence ──────────────────────────────────────────────────
  // When `recurring`, the generate-bills cron creates a fresh UtilityBill
  // each `billingCycle` on `billingDay`, then advances `nextBillDate`.
  // FIXED providers generate at `defaultAmount` (autopay-eligible);
  // VARIABLE providers generate an `estimated` placeholder to be filled.
  recurring         Boolean               @default(false)
  billingCycle      UtilityBillCycle      @default(MONTHLY)
  billingDay        Int?
  // Real-world cadences drift. TN electricity is nominally bimonthly but
  // a bill can land after one month or after ten weeks, so a fixed grid
  // either mints phantom bills or misses real ones. When `cycleVaries`,
  // `billingCycle` is treated as an EXPECTATION, not a schedule:
  //   • the generator raises a UTILITY_BILL_EXPECTED reminder ("go check
  //     for the bill") instead of creating a placeholder UtilityBill;
  //   • `nextBillDate` re-anchors off each REAL bill's date rather than
  //     marching on its own grid, so the two never drift apart.
  cycleVaries       Boolean               @default(false)
  amountMode        UtilityAmountMode     @default(VARIABLE)
  defaultAmount     Decimal?              @db.Decimal(14, 2)
  // Next date the generator should emit a bill for this provider. Null
  // when not recurring. Advanced by one cycle on each generation.
  nextBillDate      DateTime?             @db.Date
  // ── Prepaid ─────────────────────────────────────────────────────
  // Prepaid connections (JioAirFiber, mobile prepaid, prepaid DTH) are
  // paid UP FRONT and run on a validity clock instead of owing a
  // postpaid bill. `prepaid` providers never generate bills or autopay;
  // each recharge extends `validUntil` and re-points a single
  // UTILITY_RECHARGE_DUE reminder that warns before the plan expires.
  prepaid           Boolean               @default(false)
  // Current validity expiry — the date the recharge lapses. Drives the
  // expiry reminder (reminder.dueDate == validUntil) and the card copy.
  validUntil        DateTime?             @db.Date
  // Typical plan validity in days — prefills the Recharge dialog.
  rechargeValidityDays Int?
  // Running advance balance. Increased by UTILITY_ADVANCE transactions;
  // decreased by UtilityBill.advanceApplied on Pay. Never negative.
  advanceBalance    Decimal               @default(0) @db.Decimal(14, 2)
  status            UtilityProviderStatus @default(ACTIVE)
  notes             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bills        UtilityBill[]
  transactions Transaction[]        @relation("UtilityProviderTransaction")
  reminders    InvestmentReminder[] @relation("ReminderUtilityProvider")

  @@unique([workspaceId, kind, providerName, connectionNumber])
  @@index([workspaceId, status, kind])
  @@index([workspaceId, ownerUserId])
  @@index([recurring, nextBillDate])
  @@index([prepaid, validUntil])
}

model UtilityBill {
  id                String          @id @default(uuid())
  workspaceId       String
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  providerId        String
  provider          UtilityProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  billDate          DateTime        @db.Date
  dueDate           DateTime        @db.Date
  // Actual service window printed on the bill (inclusive both ends).
  // Nullable: legacy rows and quick entries fall back to deriving the
  // window from the provider's cycle (see `billPeriodRange`). Recording
  // it is what keeps the period chip, the ledger description and the
  // per-month analytics honest when the real cadence drifts off the
  // nominal cycle — a 1-month EB bill on a bimonthly connection would
  // otherwise be described, and charted, as covering two months.
  periodFrom        DateTime?       @db.Date
  periodTo          DateTime?       @db.Date
  billAmount        Decimal         @db.Decimal(14, 2)
  // Meter readings — required for ELECTRICITY, optional otherwise.
  // unitsConsumed = currentReading - previousReading when both present.
  previousReading   Decimal?        @db.Decimal(12, 3)
  currentReading    Decimal?        @db.Decimal(12, 3)
  unitsConsumed     Decimal?        @db.Decimal(12, 3)
  // How much of billAmount was paid from the provider's advance balance.
  // 0 = pure cash pay; equal to billAmount = fully paid from advance.
  advanceApplied    Decimal         @default(0) @db.Decimal(14, 2)
  // Auto-created by the generate-bills cron (vs entered by hand).
  autoGenerated     Boolean         @default(false)
  // True for a VARIABLE provider's auto-generated placeholder whose
  // amount is a guess. Autopay skips estimated bills; the user must
  // confirm the real amount (clears the flag) before it can be paid.
  estimated         Boolean         @default(false)
  paidAt            DateTime?
  paidTransactionId String?         @unique
  paidTransaction   Transaction?    @relation("UtilityBillPaidTxn")
  notes             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reminders InvestmentReminder[] @relation("ReminderUtilityBill")

  @@index([providerId, billDate])
  @@index([workspaceId, paidAt])
  @@index([workspaceId, dueDate])
}

//
// LOANS
//

model Loan {
  id                String        @id @default(uuid())
  workspaceId       String
  workspace         Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ownerUserId       String?
  ownerUser         User?         @relation("LoanOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  sharedWithUserIds String[]      @default([])
  kind              LoanKind
  source            LoanSource    @default(BANK)
  // Free-form lender display name. For HAND_FORMAL loans this is the
  // contact's name (denormalized so old loans still render if the contact
  // is later archived/renamed); other sources store the bank/NBFC name.
  lender            String
  // For HAND_FORMAL loans: the workspace contact who lent the money.
  // Optional because legacy hand loans (created before contacts existed)
  // only have the free-text `lender` field.
  lenderContactId   String?
  lenderContact     Contact?      @relation("LoanLenderContact", fields: [lenderContactId], references: [id], onDelete: SetNull)
  borrower          String?
  // The workspace contact (family member) whose name / account the loan is
  // under — e.g. a loan taken in the wife's or father's name. Distinct from
  // lenderContact (who you borrowed FROM on a hand loan).
  memberContactId   String?
  memberContact     Contact?      @relation("LoanMemberContact", fields: [memberContactId], references: [id], onDelete: SetNull)
  principal         Decimal       @db.Decimal(14, 2)
  outstanding       Decimal       @db.Decimal(14, 2)
  interestRate      Decimal?      @db.Decimal(6, 3)
  gstOnInterest     Decimal?      @db.Decimal(6, 3)
  emiAmount         Decimal?      @db.Decimal(12, 2)
  tenure            Int?
  frequency         LoanFrequency @default(MONTHLY)
  charges           Decimal?      @db.Decimal(12, 2)
  chargeBreakdown   Json?
  accountId         String?
  account           Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  cardId            String?
  card              Card?         @relation("CardEmiLoan", fields: [cardId], references: [id], onDelete: SetNull)
  // The loan account number the lender issued for this loan (bank loan
  // account number, NBFC reference, etc.). For CREDIT_CARD_LOAN kinds this
  // is the virtual loan-account number / AAN (e.g. HDFC Insta Jumbo Loan):
  // the parent credit card stays usable and EMIs bill against this number on
  // the same statement cycle as the parent card.
  loanAccountNumber String?
  // Per-loan billing-cycle overrides for CREDIT_CARD_LOAN kinds. When set,
  // they take precedence over the linked card's account.statementDate /
  // gracePeriod when computing nextDueDate. Useful when (a) the linked
  // card doesn't have those fields configured, or (b) the loan's separate
  // AAN bills on a different cycle than the parent card.
  loanStatementDate Int?
  loanGracePeriod   Int?
  isExisting        Boolean       @default(false)
  // CARD_EMI only: how much of this EMI's principal was reconciled OUT of
  // the linked card's outstanding statement balance when the EMI was added,
  // because that amount was already blocking the card's available limit.
  // The principal now lives solely in this loan (the EMI bucket), so the
  // limit isn't double-counted. Stored so the reconciliation can be undone
  // (added back to the card's outstanding) if the EMI is deleted.
  cardLimitOffset   Decimal       @default(0) @db.Decimal(14, 2)
  foreclosedAt      DateTime?
  foreclosureAmt    Decimal?      @db.Decimal(14, 2)
  startedAt         DateTime
  maturityAt        DateTime?
  nextDueDate       DateTime?
  notes             String?
  active            Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  vehicleId String?
  vehicle   Vehicle? @relation("VehicleLoan", fields: [vehicleId], references: [id], onDelete: SetNull)

  transactions Transaction[]
  reminders    InvestmentReminder[] @relation("ReminderLoan")
  goldItems    GoldLoanItem[]

  @@index([workspaceId, active, source])
  @@index([workspaceId, ownerUserId])
  @@index([cardId])
  @@index([workspaceId, lenderContactId])
  @@index([vehicleId])
}

// Gold pledged as collateral for a GOLD loan. Each row is one type of
// item (e.g. "Bangles") with a count and per-piece weight in grams plus
// karat purity. The pledged value isn't tracked here — banks recompute
// it from current gold rates.
model GoldLoanItem {
  id          String   @id @default(uuid())
  loanId      String
  loan        Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  name        String
  quantity    Int      @default(1)
  weightGrams Decimal  @db.Decimal(10, 3)
  purity      Int?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([loanId])
}

//
// INVESTMENTS + REMINDERS
//

model Investment {
  id                     String                @id @default(uuid())
  workspaceId            String
  workspace              Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ownerUserId            String?
  ownerUser              User?                 @relation("InvestmentOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  sharedWithUserIds      String[]              @default([])
  holderName             String?
  kind                   InvestmentKind
  name                   String
  institution            String?
  amount                 Decimal               @db.Decimal(14, 2)
  currentValue           Decimal?              @db.Decimal(14, 2)
  interestRate           Decimal?              @db.Decimal(6, 3)
  compoundingFrequency   CompoundingFrequency?
  fdStatus               FDStatus?
  startedAt              DateTime
  maturityAt             DateTime?
  notes                  String?
  active                 Boolean               @default(true)
  symbol                 String?
  quantity               Decimal?              @db.Decimal(18, 6)
  purchasePrice          Decimal?              @db.Decimal(14, 4)
  purchaseExchangeRate   Decimal?              @db.Decimal(10, 4)
  dividends              Decimal?              @db.Decimal(14, 2)
  exchange               String?
  currency               String?               @default("INR")
  policyNumber           String?
  policyType             InsurancePolicyType?
  insuranceStatus        InsuranceStatus?      @default(ACTIVE)
  premiumAmount          Decimal?              @db.Decimal(14, 2)
  premiumFrequency       PremiumFrequency?
  sumAssured             Decimal?              @db.Decimal(14, 2)
  nextDueDate            DateTime?
  nominee                String?
  riders                 String?
  /**
   * Structured riders for LIFE policies: { list: [{ name, sumAssured?, notes? }] }.
   * Separate from the legacy free-text `riders` field so we don't lose any
   * historic notes. New UI writes here.
   */
  ridersJson             Json?
  // Life-insurance corporate fields. All nullable — other policy types ignore them.
  policyTermYears        Int?
  premiumPayingTermYears Int?
  maturityValue          Decimal?              @db.Decimal(14, 2)
  bonusAccrued           Decimal?              @db.Decimal(14, 2)
  bonusLastRevisedAt     DateTime?
  /**
   * Kind-specific structured extras (e.g. for GOLD: { type, purity, wastage, making, gst }).
   */
  metadata               Json?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  vehicleId String?
  vehicle   Vehicle? @relation("VehicleInsurance", fields: [vehicleId], references: [id], onDelete: SetNull)

  // Renewal chain for INSURANCE policies — when a renewal issues a new
  // policy number, we create a fresh Investment row and link back to
  // the predecessor here. Deleting the predecessor sets this null so
  // the successor isn't cascade-deleted (the new row is the system of
  // record going forward).
  renewedFromInvestmentId String?
  renewedFrom             Investment?  @relation("InvestmentRenewal", fields: [renewedFromInvestmentId], references: [id], onDelete: SetNull)
  successors              Investment[] @relation("InvestmentRenewal")

  transactions   Transaction[]
  reminders      InvestmentReminder[] @relation("ReminderInvestment")
  insuredMembers InsuredMember[]      @relation("InsuranceMembers")
  claims         InsuranceClaim[]     @relation("InsuranceClaims")

  @@index([workspaceId, kind, active])
  @@index([workspaceId, ownerUserId])
  @@index([vehicleId])
  @@index([renewedFromInvestmentId])
}

model StockWishlist {
  id                String    @id @default(uuid())
  workspaceId       String
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ownerUserId       String?
  ownerUser         User?     @relation("StockWishlistOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  sharedWithUserIds String[]  @default([])
  symbol            String
  name              String?
  exchange          String?
  targetPrice       Decimal?  @db.Decimal(14, 4)
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, ownerUserId])
}

model InvestmentReminder {
  id                     String                @id @default(uuid())
  workspaceId            String
  workspace              Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  investmentId           String?
  investment             Investment?           @relation("ReminderInvestment", fields: [investmentId], references: [id], onDelete: Cascade)
  insuredMemberId        String?
  insuredMember          InsuredMember?        @relation("ReminderInsuredMember", fields: [insuredMemberId], references: [id], onDelete: Cascade)
  loanId                 String?
  loan                   Loan?                 @relation("ReminderLoan", fields: [loanId], references: [id], onDelete: Cascade)
  leaseScheduleId        String?
  leaseSchedule          LeasePaymentSchedule? @relation("ReminderLeaseSchedule", fields: [leaseScheduleId], references: [id], onDelete: Cascade)
  cardStatementId        String?
  cardStatement          CardStatement?        @relation("ReminderCardStatement", fields: [cardStatementId], references: [id], onDelete: Cascade)
  vehicleDocumentId      String?
  vehicleDocument        VehicleDocument?      @relation("ReminderVehicleDocument", fields: [vehicleDocumentId], references: [id], onDelete: Cascade)
  subscriptionId         String?
  subscription           Subscription?         @relation("ReminderSubscription", fields: [subscriptionId], references: [id], onDelete: Cascade)
  subscriptionScheduleId String?
  subscriptionSchedule   SubscriptionSchedule? @relation("ReminderSubscriptionSchedule", fields: [subscriptionScheduleId], references: [id], onDelete: Cascade)
  utilityBillId          String?
  utilityBill            UtilityBill?          @relation("ReminderUtilityBill", fields: [utilityBillId], references: [id], onDelete: Cascade)
  utilityProviderId      String?
  utilityProvider        UtilityProvider?      @relation("ReminderUtilityProvider", fields: [utilityProviderId], references: [id], onDelete: Cascade)
  vaccinationLogId       String?
  vaccinationLog         VaccinationLog?       @relation("ReminderVaccination", fields: [vaccinationLogId], references: [id], onDelete: Cascade)
  livestockBatchId       String?
  livestockBatch         LivestockBatch?       @relation("ReminderLivestockBatch", fields: [livestockBatchId], references: [id], onDelete: Cascade)
  kind                   ReminderKind
  dueDate                DateTime              @db.Date
  amount                 Decimal?              @db.Decimal(14, 2)
  status                 ReminderStatus        @default(UPCOMING)
  confirmedTransactionId String?               @unique
  confirmedTransaction   Transaction?          @relation("ReminderConfirmation", fields: [confirmedTransactionId], references: [id], onDelete: SetNull)
  skippedReason          String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([workspaceId, status, dueDate])
  @@index([investmentId])
  @@index([insuredMemberId])
  @@index([loanId])
  @@index([vehicleDocumentId])
  @@index([subscriptionId])
  @@index([subscriptionScheduleId])
  @@index([utilityBillId])
  @@index([utilityProviderId])
  @@index([vaccinationLogId])
  @@index([livestockBatchId])
}

model InsuredMember {
  id               String            @id @default(uuid())
  workspaceId      String
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  investmentId     String
  investment       Investment        @relation("InsuranceMembers", fields: [investmentId], references: [id], onDelete: Cascade)
  contactId        String
  contact          Contact           @relation("InsuredMemberContact", fields: [contactId], references: [id], onDelete: Restrict)
  premiumAmount    Decimal?          @db.Decimal(14, 2)
  premiumFrequency PremiumFrequency?
  sumAssured       Decimal?          @db.Decimal(14, 2)
  coverageStart    DateTime?
  coverageEnd      DateTime?
  active           Boolean           @default(true)
  notes            String?
  // For LIFE policies a member can be a BENEFICIARY instead of the
  // insured. Beneficiary shares are stored as a percentage and the API
  // validates that all BENEFICIARY shares on a policy sum to ≤ 100.
  role             InsuredMemberRole @default(INSURED)
  sharePercent     Decimal?          @db.Decimal(5, 2)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  reminders InvestmentReminder[] @relation("ReminderInsuredMember")
  claims    InsuranceClaim[]     @relation("ClaimInsuredMember")

  @@unique([investmentId, contactId])
  @@index([workspaceId, active])
}

model InsuranceClaim {
  id                String           @id @default(uuid())
  workspaceId       String
  workspace         Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  investmentId      String
  investment        Investment       @relation("InsuranceClaims", fields: [investmentId], references: [id], onDelete: Cascade)
  insuredMemberId   String?
  insuredMember     InsuredMember?   @relation("ClaimInsuredMember", fields: [insuredMemberId], references: [id], onDelete: SetNull)
  vehicleId         String?
  vehicle           Vehicle?         @relation("VehicleClaims", fields: [vehicleId], references: [id], onDelete: SetNull)
  medicalRecordId   String?          @unique
  medicalRecord     MedicalRecord?   @relation("MedicalRecordClaim", fields: [medicalRecordId], references: [id], onDelete: SetNull)
  claimNumber       String?
  incidentDate      DateTime
  filedAt           DateTime?
  status            ClaimStatus      @default(FILED)
  claimedAmount     Decimal?         @db.Decimal(14, 2)
  approvedAmount    Decimal?         @db.Decimal(14, 2)
  receivedAmount    Decimal?         @db.Decimal(14, 2)
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  transactions Transaction[] @relation("TransactionClaim")

  @@index([workspaceId, status])
  @@index([investmentId])
  @@index([vehicleId])
}

/**
 * One medical event for a person (patientContact): either an outpatient
 * CHECKUP (fever, cold, consultation — occurredAt is the visit date,
 * dischargedAt stays null) or a HOSPITALIZATION episode (occurredAt is
 * the admission date, dischargedAt the discharge; null while ongoing).
 */
model MedicalRecord {
  id               String            @id @default(uuid())
  workspaceId      String
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patientContactId String
  patientContact   Contact           @relation("MedicalRecordPatient", fields: [patientContactId], references: [id], onDelete: Restrict)
  kind             MedicalRecordKind @default(HOSPITALIZATION)
  facilityName     String
  diagnosis        String?
  occurredAt       DateTime
  dischargedAt     DateTime?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  transactions Transaction[]   @relation("TransactionMedicalRecord")
  claim        InsuranceClaim? @relation("MedicalRecordClaim")

  @@index([workspaceId, occurredAt])
  @@index([workspaceId, patientContactId])
}

model Notification {
  id          String           @id @default(uuid())
  workspaceId String
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /**
   * Null = workspace-wide broadcast (shown to every member).
   */
  userId      String?
  user        User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        NotificationKind
  title       String
  body        String?
  /**
   * Deep link (e.g. /insurance/123, /medical/45) used by the inbox row.
   */
  link        String?
  readAt      DateTime?
  emailedAt   DateTime?
  /**
   * Optional source-row identifiers. Used by the cron sweep to dedupe
   * — re-running the sweep won't create duplicate rows for the same
   * (reminderId, kind) pair.
   */
  reminderId  String?
  claimId     String?
  createdAt   DateTime         @default(now())

  @@index([workspaceId, userId, readAt])
  @@index([workspaceId, createdAt])
  @@index([reminderId, kind])
}

model Vehicle {
  id             String           @id @default(uuid())
  workspaceId    String
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ownerContactId String
  ownerContact   Contact          @relation("VehicleOwner", fields: [ownerContactId], references: [id], onDelete: Restrict)
  kind           VehicleKind
  name           String
  make           String?
  model          String?
  year           Int?
  // Unique WITHIN a workspace (see @@unique below), not globally — the
  // same plate can legitimately exist in two different workspaces.
  registrationNo String?
  // Drives the unit on fuel-fill inputs and the mileage formula.
  // Nullable so legacy rows are unaffected.
  fuelType       VehicleFuelType?
  purchaseDate   DateTime?
  purchasePrice  Decimal?         @db.Decimal(14, 2)
  odometerStart  Int?
  active         Boolean          @default(true)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Disposal — set when the vehicle leaves the household (sold / exchanged
  // / scrapped / gifted / written off). `active` is also flipped to false
  // at the same time; this block answers "what happened to it?". For
  // EXCHANGED disposals, `replacedById` points at the new vehicle that
  // took its place. For SOLD / GIFTED, `disposalContactId` is the buyer
  // or recipient (a workspace Contact).
  disposedAt        DateTime?
  disposalKind      VehicleDisposalKind?
  disposalAmount    Decimal?             @db.Decimal(14, 2)
  disposalContactId String?
  disposalContact   Contact?             @relation("VehicleDisposalBuyer", fields: [disposalContactId], references: [id], onDelete: SetNull)
  replacedById      String?
  replacedBy        Vehicle?             @relation("VehicleReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces          Vehicle[]            @relation("VehicleReplacement")

  insurances   Investment[]      @relation("VehicleInsurance")
  loans        Loan[]            @relation("VehicleLoan")
  claims       InsuranceClaim[]  @relation("VehicleClaims")
  transactions Transaction[]     @relation("VehicleTransaction")
  documents    VehicleDocument[]

  @@unique([workspaceId, registrationNo])
  @@index([workspaceId, active])
  @@index([workspaceId, ownerContactId])
  @@index([disposalContactId])
  @@index([replacedById])
}

model VehicleDocument {
  id                 String              @id @default(uuid())
  workspaceId        String
  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  vehicleId          String
  vehicle            Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  kind               VehicleDocumentKind
  label              String? // free-form (e.g. "RC for new card", "PUC Bangalore")
  number             String? // document reference number printed on the doc
  issuedAt           DateTime?
  expiryAt           DateTime? // the date that drives renewal reminders
  notes              String?
  // Legacy inline attachment columns — kept for one release while the
  // generic Attachment model takes over. After backfill these are
  // read-only mirrors; new uploads only land in Attachment.
  attachmentKey      String?
  attachmentFilename String?
  attachmentMimeType String?
  attachmentSize     Int?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  reminders InvestmentReminder[] @relation("ReminderVehicleDocument")

  @@index([workspaceId, expiryAt])
  @@index([vehicleId])
  @@index([workspaceId, kind])
}

//
// ATTACHMENTS — polymorphic file metadata for every domain that needs
// uploads (vehicle docs, insurance policy scans, card statements,
// expense receipts, crop bills, loan documents, income proofs, …).
//
// The owner pointer (ownerKind + ownerId) is a soft FK. Referential
// integrity is enforced at the API layer (verify the parent row, then
// the workspaceId, then the S3 key prefix). Doing it this way keeps
// new owner kinds plug-and-play: add the enum value + a row in
// src/lib/attachments.ts and you're done — no schema migration needed.
//

enum AttachmentOwnerKind {
  VEHICLE_DOCUMENT
  INSURANCE_POLICY
  CARD_STATEMENT
  TRANSACTION_RECEIPT
  CROP_BATCH_BILL
  LOAN_DOCUMENT
  INCOME_PROOF
  CONTACT_DOCUMENT
  EVENT_DOCUMENT
  UTILITY_BILL
  SUBSCRIPTION_DOCUMENT
  LIVESTOCK_BATCH_DOCUMENT
  LIVESTOCK_CONTRACT_DOCUMENT
  MEDICAL_RECORD_DOCUMENT
}

//
// EVENTS — time-bounded spending containers (trips, functions,
// festivals, projects, medical episodes). Transactions tag into an
// Event via Transaction.eventId; the Event detail page rolls them up
// across categories. Member splits reuse the existing MemberCharge
// model — no new table required.
//
enum EventKind {
  TRIP // vacations, day trips, pilgrimages
  FUNCTION // wedding, birthday, anniversary
  FESTIVAL // Diwali, Pongal, Christmas
  PROJECT // home renovation, garden setup
  MEDICAL // surgery + recovery period
  OTHER
}

model Event {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  kind        EventKind @default(TRIP)
  startedAt   DateTime
  endedAt     DateTime?
  notes       String?
  budget      Decimal?  @db.Decimal(14, 2)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  transactions Transaction[] @relation("EventTransaction")

  @@index([workspaceId, active])
  @@index([workspaceId, startedAt])
}

model Attachment {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  ownerKind AttachmentOwnerKind
  ownerId   String

  // S3 bucket-relative key. Globally unique so a deleted-and-recreated
  // row can't collide with a stale presigned URL.
  s3Key     String  @unique
  filename  String
  mimeType  String
  sizeBytes Int
  // SHA-256 of the object body, optional. Populated by the client when
  // it can; used to detect S3-side corruption / silent re-writes.
  checksum  String?

  // Audit: WHO uploaded this, and (if applicable) who archived it.
  uploadedByUserId String
  uploadedBy       User     @relation("AttachmentUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  uploadedAt       DateTime @default(now())

  archivedAt       DateTime?
  archivedByUserId String?
  archivedBy       User?     @relation("AttachmentArchiver", fields: [archivedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, ownerKind, ownerId, archivedAt])
  @@index([workspaceId, uploadedByUserId])
}

//
// WORKERS
//

model Worker {
  id                String                @id @default(uuid())
  workspaceId       String
  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name              String
  phone             String?
  dailyRate         Decimal?              @db.Decimal(10, 2)
  settlementCadence WageSettlementCadence @default(AS_NEEDED)
  customCadenceDays Int?
  active            Boolean               @default(true)
  archivedAt        DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  attendance        Attendance[]
  wagePayments      WagePayment[]
  wageSettlements   WageSettlement[]
  advanceRepayments AdvanceRepayment[]
  transactions      Transaction[]

  @@index([workspaceId, active])
}

model Attendance {
  id                String          @id @default(uuid())
  workerId          String
  worker            Worker          @relation(fields: [workerId], references: [id], onDelete: Cascade)
  date              DateTime        @db.Date
  present           Boolean         @default(true)
  dailyRateOverride Decimal?        @db.Decimal(10, 2)
  quantity          Decimal?        @db.Decimal(8, 2)
  rate              Decimal?        @db.Decimal(10, 2)
  cropBatchId       String?
  cropBatch         CropBatch?      @relation(fields: [cropBatchId], references: [id], onDelete: SetNull)
  livestockBatchId  String?
  livestockBatch    LivestockBatch? @relation(fields: [livestockBatchId], references: [id], onDelete: SetNull)
  notes             String?
  createdAt         DateTime        @default(now())

  @@unique([workerId, date])
  @@index([workerId, date])
}

model WagePayment {
  id            String       @id @default(uuid())
  workerId      String
  worker        Worker       @relation(fields: [workerId], references: [id], onDelete: Cascade)
  amount        Decimal      @db.Decimal(12, 2)
  paidAt        DateTime
  paidByUserId  String
  paidByUser    User         @relation(fields: [paidByUserId], references: [id], onDelete: Restrict)
  isBonus       Boolean      @default(false)
  isAdvance     Boolean      @default(false)
  notes         String?
  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())

  @@index([workerId, paidAt])
}

// Money returned by a worker against a prior advance. Treated as a
// contra-expense (linked Transaction is type=EXPENSE, kind=WAGE, amount<0)
// so account balances and wage-expense rollups net automatically.
// Append-only: deletes happen via reversal entries (reversedAt + linked
// pair), never DELETE.
model AdvanceRepayment {
  id               String       @id @default(uuid())
  workspaceId      String
  workspace        Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workerId         String
  worker           Worker       @relation(fields: [workerId], references: [id], onDelete: Cascade)
  amount           Decimal      @db.Decimal(12, 2)
  receivedAt       DateTime
  receivedByUserId String
  receivedByUser   User         @relation("AdvanceRepaymentReceiver", fields: [receivedByUserId], references: [id], onDelete: Restrict)
  notes            String?
  idempotencyKey   String?
  transactionId    String?      @unique
  transaction      Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  reversedAt       DateTime?
  reversedByUserId String?
  reversedByUser   User?        @relation("AdvanceRepaymentReverser", fields: [reversedByUserId], references: [id], onDelete: SetNull)
  reversalReason   String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([workerId, idempotencyKey])
  @@index([workspaceId, receivedAt])
  @@index([workerId, receivedAt])
}

model WageSettlement {
  id              String                @id @default(uuid())
  workerId        String
  worker          Worker                @relation(fields: [workerId], references: [id], onDelete: Cascade)
  periodStart     DateTime              @db.Date
  periodEnd       DateTime              @db.Date
  cadence         WageSettlementCadence
  earnedAmount    Decimal               @db.Decimal(12, 2)
  paidAmount      Decimal               @db.Decimal(12, 2)
  amountDue       Decimal               @db.Decimal(12, 2)
  status          WageSettlementStatus  @default(PENDING)
  settledAt       DateTime?
  settledByUserId String?
  settledByUser   User?                 @relation(fields: [settledByUserId], references: [id], onDelete: SetNull)
  snapshot        Json?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([workerId, periodStart, periodEnd])
  @@index([workerId, status, periodEnd])
}

//
// AUDIT
//

model AuditLog {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      String
  entityType  String
  entityId    String
  diff        Json?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
  @@index([entityType, entityId])
}
