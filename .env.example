# Copy to .env.local and fill in. Never commit the filled version.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kalanjiyam?schema=public"
# Optional direct URL used only by prisma CLI (bypasses pooler) — set same as DATABASE_URL if not using Neon/pgbouncer
DIRECT_DATABASE_URL=""

# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60

# SMTP (Mailtrap / Gmail app password / Resend / whatever)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Kalanjiyam <no-reply@kalanjiyam.local>"

APP_BASE_URL="http://localhost:3000"

# Shared secret for the daily /api/cron/notifications sweep. Vercel Cron
# (or your scheduler) must send `Authorization: Bearer <CRON_SECRET>`.
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# Environment routing — drives the S3 key prefix and other env-aware
# behaviour. On Vercel leave blank; VERCEL_ENV is mapped automatically
# (production → prod, preview → preview, development → dev).
# Allowed values: prod | preview | dev | test
APP_ENV="dev"

# --- AWS S3 (file attachments) ---
# Powers every upload surface: vehicle documents (RC/FC/PUC/road tax/
# insurance copies) and the generic /api/attachments API used by
# insurance scans, card statements, expense receipts, crop bills, loan
# documents, income proofs.
#
# Keys are written under:
#   {AWS_S3_PREFIX/}{env}/workspaces/{workspaceId}/{entityPath}/{ownerId}/
#     {yyyy}/{mm}/{uploadId}-{filename}
#
# Bucket hardening recommended:
#   - Block all public access ON
#   - Versioning ON (production bucket)
#   - Lifecycle: expire dev/* after 30d, preview/* after 14d,
#                abort incomplete multipart uploads after 7d
#   - CORS: allow PUT + GET from your app origin(s)
#   - IAM: scope PutObject / GetObject / DeleteObject to this bucket only
AWS_S3_BUCKET=""
AWS_S3_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Optional namespace for shared buckets (e.g. "kalanjiyam/"). Leave
# blank for a dedicated bucket.
AWS_S3_PREFIX=""

# --- DB backup + restore ---
# Daily pg_dump runs in GitHub Actions (.github/workflows/db-backup.yml).
# Keys land at  s3://$AWS_S3_BUCKET/$AWS_S3_BACKUP_PREFIX/YYYY-MM-DD.dump
# and the workflow prunes anything older than the newest 3.
#
# The workflow does NOT send mail itself — it POSTs the run result to
# /api/cron/backup-notify, which renders the email through the app's
# own _layout.ts so it matches every other Kalanjiyam transactional mail.
#
# GitHub repo secrets to set (Settings → Secrets and variables → Actions):
#   DB_BACKUP_DATABASE_URL  — connection string for pg_dump source
#   AWS_ACCESS_KEY_ID       — IAM user scoped to PutObject/ListBucket/
#                              DeleteObject on the backup prefix only
#   AWS_SECRET_ACCESS_KEY
#   AWS_S3_REGION           — e.g. ap-south-1
#   AWS_S3_BUCKET
#   AWS_S3_BACKUP_PREFIX    — optional, defaults to "db-backups"
#   APP_URL                 — e.g. https://kalanjiyam.app (Vercel prod URL)
#   CRON_SECRET             — same value already used by Vercel crons
#
# App env (Vercel — needed for /api/cron/backup-notify):
#   BACKUP_NOTIFY_EMAIL     — silambu.a@icloud.com (success + failure mail)
#   (reuses existing SMTP_* + AUTH_URL + CRON_SECRET)
BACKUP_NOTIFY_EMAIL="silambu.a@icloud.com"

# Restore prefix used by /api/restore/db. Must match the workflow value.
AWS_S3_BACKUP_PREFIX="db-backups"

# Required to use POST /api/restore/db (local-only endpoint). Generate
# with: openssl rand -hex 32. Refuses to start if shorter than 24 chars.
# The endpoint additionally rejects every request unless:
#   - NODE_ENV !== "production"
#   - Host header resolves to localhost / 127.0.0.1 / ::1
#   - DATABASE_URL points at a local host
#   - Body contains   { "date": "YYYY-MM-DD", "confirm": "RESTORE" }
# pg_restore must be on the local PATH (brew install postgresql@17).
RESTORE_SECRET=""
